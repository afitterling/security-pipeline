# cp terraform.tfvars.example terraform.tfvars  (gitignored)
name        = "security-pipeline"
region      = "eu-central-1"
aws_profile = "alex1-dev"

# Where this repo lives; Argo CD needs read access to it.
git_repo_url = "https://github.com/<you>/security-pipeline.git"
git_revision = "main"
# Only needed for a private repo. Prefer: TF_VAR_git_token=ghp_... make apply
# git_username = "git"
# git_token    = ""

# Lock down the EKS API endpoint to your IP(s)
cluster_endpoint_public_access_cidrs = ["203.0.113.4/32"]

node_instance_types = ["t3.xlarge"]
node_desired_size   = 2
node_max_size       = 4
